@page "/about"
@inject AppConfig AppConfig

<PageTitle>Über BSN-Tools</PageTitle>

<Window Title="Über BSN-Tools">

    <Content>
        <div class="about-content">
            <img src="img/logo.png" alt="BSN-Tools Logo" />

            <p>
                <strong>Über BSN-Tools</strong>
            </p>

            <p>
                Verschiedene Tools für den BSN-Unterricht/Bereich.
            </p>

            <p>
                Design & Entwicklung von CalamitySasha (Sasha/Lynn)
            </p>

            <p>Version @version.Major.@version.Minor.@version.Build Build @version.Revision</p>

            @if (AppConfig.IsAzureTestInstance)
            {
                <p>
                    <strong>Diese Version ist eine Entwicklungs-Testinstanz, die auf Azure bereitgestellt wurde. <br />Sie ist und könnte instabil sein und Fehler enthalten, und entspricht nicht der finalen Version.</strong>
                </p>

                <p>
                    Azure-Testinstanz: @AppConfig.GetAzureTestInstanceDeployment()
                </p>
            }

            <a href="https://github.com/zxrohex/BSNTools.Web" target="_blank">GitHub Repository</a>

        </div>
    </Content>
</Window>

@code {
    Version version = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version!;
}